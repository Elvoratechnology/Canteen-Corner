generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Facility {
  id                  String     @id @default(cuid())
  name                String
  weeklyResetDay      Int        @default(0) // 0 = Sunday, 1 = Monday, etc.
  giftPackagesEnabled Boolean    @default(true)
  maxWeeklySpend      Float      @default(100.0)
  maxDepositAmount    Float      @default(300.0)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  offenders           Offender[]
  manifests           Manifest[]
  products            Product[]
  users               User[]
}

model User {
  id                   String          @id @default(cuid())
  email                String?         @unique
  staffId              String?         @unique
  passwordHash         String?
  name                 String
  role                 String          // INMATE, FAMILY, WAREHOUSE_PICKER, WAREHOUSE_SUPERVISOR, ADMIN
  failedLoginAttempts  Int             @default(0)
  lockedUntil          DateTime?
  emailVerified        Boolean         @default(false)
  verificationToken    String?
  facilityId           String?
  facility             Facility?       @relation(fields: [facilityId], references: [id])
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  offender             Offender?
  familyAccount        FamilyAccount?
  pickingLists         PickingList[]
}

model Offender {
  id                 String          @id // Offender ID e.g. "A1234567"
  userId             String?         @unique
  facilityId         String
  name               String
  unit               String
  housing            String
  pinHash            String
  balance            Float           @default(0.0)
  weeklyLimit        Float           @default(100.0)
  currentWeeklySpent Float           @default(0.0)
  lastWeeklyReset    DateTime        @default(now())
  failedPinAttempts  Int             @default(0)
  pinLockedUntil     DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  facility           Facility        @relation(fields: [facilityId], references: [id])
  user               User?           @relation(fields: [userId], references: [id])
  orders             Order[]
  deposits           Deposit[]
  ledgerEntries      LedgerEntry[]
  giftPackages       GiftPackage[]
  notifications      Notification[]
  familyOffenderLinks FamilyOffenderLink[]
}

model FamilyAccount {
  id            String        @id @default(cuid())
  userId        String        @unique
  relationship  String        @default("Family")
  verifiedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id])
  deposits      Deposit[]
  giftPackages  GiftPackage[]
  familyOffenderLinks FamilyOffenderLink[]
}

model Product {
  id           String      @id @default(cuid())
  sku          String      @unique
  name         String
  category     String      // Snacks, Beverages, Personal Care, Stationery, Health & Wellness
  price        Float
  stock        Int
  reorderLevel Int         @default(15)
  active       Boolean     @default(true)
  imageUrl     String?
  description  String?
  facilityId   String?
  facility     Facility?   @relation(fields: [facilityId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  orderItems   OrderItem[]
}

model Order {
  id                   String               @id @default(cuid())
  orderNumber          String               @unique // Format #CC-xxxxx
  offenderId           String
  status               String               @default("PROCESSING") // PROCESSING, PACKED, OUT_FOR_DELIVERY, DELIVERED, CANCELLED
  subtotal             Float
  tax                  Float                @default(0.0)
  total                Float
  expectedDeliveryDate DateTime
  deliveredAt          DateTime?
  pickedByStaffId      String?
  packedAt             DateTime?
  barcode              String               @unique
  manifestId           String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  offender             Offender             @relation(fields: [offenderId], references: [id])
  manifest             Manifest?            @relation(fields: [manifestId], references: [id])
  items                OrderItem[]
  statusHistory        OrderStatusHistory[]
  pickingList          PickingList?
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  productId  String
  quantity   Int
  unitPrice  Float
  totalPrice Float
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])
}

model OrderStatusHistory {
  id             String   @id @default(cuid())
  orderId        String
  previousStatus String?
  newStatus      String
  changedBy      String
  notes          String?
  createdAt      DateTime @default(now())
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Deposit {
  id              String         @id @default(cuid())
  offenderId      String
  familyAccountId String?
  amount          Float
  fee             Float          @default(0.0)
  totalPaid       Float
  provider        String         @default("TOUCHPAY")
  providerRef     String         @unique
  status          String         @default("PENDING") // PENDING, SUCCEEDED, FAILED
  idempotencyKey  String         @unique
  completedAt     DateTime?
  createdAt       DateTime       @default(now())
  offender        Offender       @relation(fields: [offenderId], references: [id])
  familyAccount   FamilyAccount? @relation(fields: [familyAccountId], references: [id])
}

model LedgerEntry {
  id            String   @id @default(cuid())
  offenderId    String
  type          String   // DEPOSIT, COMMISSARY_ORDER, REFUND, INVENTORY_RESTOCK, ADJUSTMENT
  debit         Float    @default(0.0) // Deducted from inmate balance
  credit        Float    @default(0.0) // Added to inmate balance
  balanceBefore Float
  balanceAfter  Float
  referenceType String   // ORDER, DEPOSIT, MANUAL
  referenceId   String
  description   String
  createdAt     DateTime @default(now())
  offender      Offender @relation(fields: [offenderId], references: [id])
}

model GiftPackage {
  id              String        @id @default(cuid())
  offenderId      String
  familyAccountId String
  packageName     String
  itemsJson       String        // JSON array of items and quantities
  totalValue      Float
  status          String        @default("PENDING") // PENDING, APPROVED, REJECTED, SHIPPED
  reviewerId      String?
  reviewerNotes   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  offender        Offender      @relation(fields: [offenderId], references: [id])
  familyAccount   FamilyAccount @relation(fields: [familyAccountId], references: [id])
}

model Notification {
  id         String   @id @default(cuid())
  offenderId String?
  userId     String?
  type       String   // ORDER_RECEIVED, STATUS_UPDATE, DEPOSIT_RECEIVED
  title      String
  message    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
  offender   Offender? @relation(fields: [offenderId], references: [id])
}

model PickingList {
  id           String    @id @default(cuid())
  orderId      String    @unique
  pickerUserId String?
  status       String    @default("PENDING") // PENDING, PICKING, PACKED
  startedAt    DateTime?
  completedAt  DateTime?
  order        Order     @relation(fields: [orderId], references: [id])
  pickerUser   User?     @relation(fields: [pickerUserId], references: [id])
}

model Manifest {
  id             String   @id @default(cuid())
  manifestNumber String   @unique // #MN-YYYYMMDD-UNIT
  facilityId     String
  unit           String
  housing        String?
  deliveryDate   DateTime
  status         String   @default("GENERATED") // GENERATED, DISPATCHED
  totalOrders    Int      @default(0)
  totalItems     Int      @default(0)
  createdAt      DateTime @default(now())
  facility       Facility @relation(fields: [facilityId], references: [id])
  orders         Order[]
}

model AuditLog {
  id           String   @id @default(cuid())
  action       String
  actorId      String
  actorRole    String
  ipAddress    String?
  resourceType String
  resourceId   String?
  metadata     String?
  createdAt    DateTime @default(now())
}

model FamilyOffenderLink {
  id              String        @id @default(cuid())
  familyAccountId String
  offenderId      String
  status          String        @default("APPROVED") // PENDING, APPROVED, BLOCKED
  relationship    String        @default("Family")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  familyAccount   FamilyAccount @relation(fields: [familyAccountId], references: [id], onDelete: Cascade)
  offender        Offender      @relation(fields: [offenderId], references: [id], onDelete: Cascade)

  @@unique([familyAccountId, offenderId])
}


