# Environment Configuration for Canteen Corner
DATABASE_URL="file:./dev.db" # or postgresql://postgres:postgres@localhost:5432/canteen_corner?schema=public
JWT_SECRET="replace_with_a_secure_random_secret"
NODE_ENV="development"

# ==============================================================================
# Stripe Payment Provider Configuration
# ==============================================================================
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key_here"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret_here"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key_here"

# ==============================================================================
# PayPal Payment Provider Configuration
# ==============================================================================
PAYPAL_CLIENT_ID="your_paypal_client_id_here"
PAYPAL_CLIENT_SECRET="your_paypal_client_secret_here"
PAYPAL_WEBHOOK_ID="your_paypal_webhook_id_here"
PAYPAL_ENVIRONMENT="sandbox" # "sandbox" or "live"

# Facility Rules
WEEKLY_RESET_DAY=0
DEFAULT_WEEKLY_LIMIT=100.00

# ==============================================================================
# Supabase Configuration
# ==============================================================================
# Public Client Variables (Safe for browser client)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here"

# Server-Only Privileged Key (CRITICAL: NEVER expose to browser or prefix with NEXT_PUBLIC_)
# Used exclusively for external webhook verification and admin database functions
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_key_here"
