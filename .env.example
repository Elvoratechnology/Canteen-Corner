# Environment Configuration for Canteen Corner
DATABASE_URL="file:./dev.db" # or postgresql://postgres:postgres@localhost:5432/canteen_corner?schema=public
JWT_SECRET="canteen-corner-super-secure-production-jwt-key-2026-correctional-facility"
NODE_ENV="development"

# TouchPay Payment Provider Configuration
TOUCHPAY_PROVIDER_TYPE="mock" # "mock" or "touchpay"
TOUCHPAY_API_KEY="your_touchpay_api_key_here"
TOUCHPAY_WEBHOOK_SECRET="your_touchpay_webhook_secret_here"
TOUCHPAY_FACILITY_ID="FACILITY_CC_01"

# Facility Rules
WEEKLY_RESET_DAY=0
DEFAULT_WEEKLY_LIMIT=100.00

